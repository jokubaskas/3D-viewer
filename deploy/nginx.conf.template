# nginx šablonas: ${NODEODM_TOKEN} įrašomas paleidžiant konteinerį (envsubst).
# Programa per /odm/ pasiekia NodeODM be rakto – jį prideda serveris.
map $arg_token $odm_token_prefix {
  ""      "token=${NODEODM_TOKEN}&";
  default "";
}

server {
  listen 80;
  # Docker DNS: paslaugų adresai ieškomi užklausos metu, todėl programa veikia
  # net jei AI ar NodeODM konteineris dar paleidžiamas ar sustojęs (grąžinama 502, o ne nginx klaida)
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $ai_upstream ai:8000;
  set $odm_upstream nodeodm:3000;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Didžiuliai nuotraukų įkėlimai (1000+ nuotraukų po 10–20 MB)
  client_max_body_size 0;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Vietinė AI paslauga
  location /ai/ {
    rewrite ^/ai/(.*)$ /$1 break;
    proxy_pass http://$ai_upstream;
    proxy_http_version 1.1;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_set_header Host $host;
  }

  # NodeODM API per tą patį adresą (be CORS problemų)
  location /odm/ {
    set $args "${odm_token_prefix}${args}";
    rewrite ^/odm/(.*)$ /$1 break;
    proxy_pass http://$odm_upstream;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
