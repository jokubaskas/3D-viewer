# nginx šablonas: ${NODEODM_TOKEN} įrašomas paleidžiant konteinerį (envsubst).
# Programa per /odm/ pasiekia NodeODM be rakto – jį prideda serveris.
map $arg_token $odm_token_prefix {
  ""      "token=${NODEODM_TOKEN}&";
  default "";
}

server {
  listen 80;
  # Docker DNS: paslaugų adresai ieškomi užklausos metu, todėl programa veikia
  # net jei AI ar NodeODM konteineris dar paleidžiamas ar sustojęs (grąžinama 502, o ne nginx klaida)
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $ai_upstream ai:8000;
  set $odm_upstream nodeodm:3000;
  set $live_upstream mediamtx;
  set $portal_upstream portal:8000;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Didžiuliai nuotraukų įkėlimai (1000+ nuotraukų po 10–20 MB)
  client_max_body_size 0;

  add_header X-Content-Type-Options nosniff always;
  # Kitoms svetainėms siunčiamas tik adresas be kelio (OpenStreetMap plytelės be jo blokuojamos – „Access blocked“)
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options SAMEORIGIN always;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Portalas: paskyros, prieigos teisės, klientų duomenys (3D modeliai, ataskaitos, įrašai)
  location /api/ {
    proxy_pass http://$portal_upstream;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # Prieigos tikrinimas (auth_request): kiekviena ODM / AI / transliacijų užklausa – tik prisijungusiam ir tik
  # su teisėmis (klientui – tik jam priskirtos transliacijos ir AI aptikimas; ODM, AI mokymas, serverio API – adminui)
  location = /_auth {
    internal;
    proxy_pass http://$portal_upstream/api/auth/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # Vietinė AI paslauga
  location /ai/ {
    auth_request /_auth;
    rewrite ^/ai/(.*)$ /$1 break;
    proxy_pass http://$ai_upstream;
    proxy_http_version 1.1;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_set_header Host $host;
  }

  # NodeODM API per tą patį adresą (be CORS problemų)
  location /odm/ {
    auth_request /_auth;
    set $args "${odm_token_prefix}${args}";
    rewrite ^/odm/(.*)$ /$1 break;
    proxy_pass http://$odm_upstream;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # Tiesioginės transliacijos (MediaMTX). API – tik šaltinio užregistravimas ir sąrašas.
  location ~ ^/live/api/(v3/config/paths/(get|replace)/[A-Za-z0-9_-]+|v3/paths/(list|get/[A-Za-z0-9_-]+))$ {
    # CORS nginx pusėje: MediaMTX atmeta „Origin: null“ (programa atidaryta iš disko, file://)
    proxy_hide_header Access-Control-Allow-Origin;
    add_header Access-Control-Allow-Origin * always;
    add_header Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, If-Match, Authorization" always;
    add_header Access-Control-Expose-Headers "Location, ETag, Link" always;
    if ($request_method = OPTIONS) { return 204; }
    auth_request /_auth;
    rewrite ^/live/api/(.*)$ /$1 break;
    proxy_set_header Origin "";
    proxy_set_header Sec-Fetch-Site "";
    proxy_pass http://$live_upstream:9997;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }
  # WebRTC (WHEP) pasiruošimas: /live/webrtc/<kelias>/whep
  location /live/webrtc/ {
    proxy_hide_header Access-Control-Allow-Origin;
    add_header Access-Control-Allow-Origin * always;
    add_header Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, If-Match, Authorization" always;
    add_header Access-Control-Expose-Headers "Location, ETag, Link" always;
    if ($request_method = OPTIONS) { return 204; }
    auth_request /_auth;
    rewrite ^/live/webrtc/(.*)$ /$1 break;
    proxy_set_header Origin "";
    proxy_set_header Sec-Fetch-Site "";
    proxy_pass http://$live_upstream:8889;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
  # Dronų telemetrija (diab) per serverį: /ext/diab/<kas>.diab.app/<kelias> → wss://<kas>.diab.app/<kelias>.
  # Naršyklė jungiasi prie mūsų serverio, o šis – prie diab su diab „Origin“ (jei diab neleidžia kitų svetainių).
  # Leidžiami tik *.diab.app adresai – tai ne atviras tarpininkas.
  location ~ ^/ext/diab/(?<diab_host>[a-z0-9-]+\.diab\.app)/(?<diab_path>.*)$ {
    auth_request /_auth;
    proxy_pass https://$diab_host/$diab_path$is_args$args;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $diab_host;
    proxy_set_header Origin https://$diab_host;
    proxy_ssl_server_name on;
    proxy_ssl_name $diab_host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
  # HLS: /live/hls/<kelias>/index.m3u8
  location /live/hls/ {
    proxy_hide_header Access-Control-Allow-Origin;
    add_header Access-Control-Allow-Origin * always;
    add_header Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, If-Match, Authorization" always;
    add_header Access-Control-Expose-Headers "Location, ETag, Link" always;
    if ($request_method = OPTIONS) { return 204; }
    auth_request /_auth;
    rewrite ^/live/hls/(.*)$ /$1 break;
    proxy_set_header Origin "";
    proxy_set_header Sec-Fetch-Site "";
    proxy_pass http://$live_upstream:8888;
    # MediaMTX peradresuoja į „/<kelias>/…?cookieCheck=1“ – grąžiname mūsų priešdėlį
    proxy_redirect / /live/hls/;
    absolute_redirect off;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 60s;
    proxy_set_header Host $host;
  }
}
