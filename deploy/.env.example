# Slaptas raktas, kurį reikės įvesti programoje („Iš nuotraukų“ → Raktas)
NODEODM_TOKEN=pakeiskite-i-ilga-atsitiktini-rakta
# Vienu metu apdorojamų projektų skaičius
NODEODM_PARALLEL=1
# Kiek minučių laikyti rezultatus serveryje (43200 = 30 d.)
NODEODM_KEEP_MINUTES=43200
# Programos prievadas
WEB_PORT=8080
# AI: aptikimo modelio dydis (nano – greičiausias, medium – tiksliausias) ir CPU gijų skaičius
AI_DETECTOR=medium
AI_THREADS=4
# Tiesioginės transliacijos: prievadai, į kuriuos dronas / kamera siunčia vaizdą
LIVE_RTMP_PORT=1935
LIVE_RTSP_PORT=8554
# Kompiuterio adresai WebRTC vaizdui (žiūrint iš kito kompiuterio pridėkite šio kompiuterio IP)
LIVE_HOSTS=127.0.0.1
# Transliacijų persiuntėjas (VPS su viešu IP) – klientams iš interneto WebRTC su mažu vėlavimu, kai šis kompiuteris
# be viešo IP (pvz. mobilusis internetas). Užpildo deploy\relay-setup.bat – ranka keisti nereikia.
RELAY_HOST=
RELAY_KEY=
RELAY_AUTH=

# NVIDIA GPU: start-windows.bat jį naudoja automatiškai (OpenDroneMap ir AI greitesni). 0 – nenaudoti.
USE_GPU=

# Atsarginės duomenų kopijos (paskyros, užsakymai ir jų istorija, klientų failai). Tuščia – šalia programos aplanko
# (atea3d-atsargines-kopijos). Geriausia – kitas diskas, pvz. BACKUP_DIR=O:\ (disko šaknyje sukuriamas aplankas
# Atea3D-atsargines-kopijos). Tinklo ar USB diskas: kopijos daromos vietoje ir kas valandą nukopijuojamos į jį.
BACKUP_DIR=

# ---------------------------------------------------------------- Prieiga iš interneto
# Adresas, kuriuo programa atidaroma (kvietimų nuorodoms), pvz. https://3d.jusu-domenas.lt
PUBLIC_URL=http://localhost:8080
# Cloudflare Tunnel raktas (Cloudflare Zero Trust → Networks → Tunnels → jūsų tunelis → raktas).
# Palikite tuščią, jei programa naudojama tik šiame kompiuteryje / vietiniame tinkle.
CF_TUNNEL_TOKEN=
